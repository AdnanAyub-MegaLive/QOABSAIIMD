# Server-only secrets. Set real values in the deployment environment or .env.local.
DATABASE_URL=
AUTH_SECRET=
MOBILE_SESSION_TTL_SECONDS=2592000
# In production, set both values after the reverse proxy overwrites geo headers.
GEOLOCATION_REQUIRED=false
TRUST_PROXY_GEO_HEADERS=false
TRTC_SDK_APP_ID=
TRTC_SECRET_KEY=
# Google Web/Server client ID whose ID-token audience this server accepts.
# Never set a Google client secret here or in an Android APK.
GOOGLE_SERVER_CLIENT_ID=

# A provider-neutral checkout gateway. Configure after selecting a payment provider.
PAYMENT_CHECKOUT_BASE_URL=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
# Temporary compatibility only. Keep false in production after the payment provider
# sends the HMAC signature documented in docs/mobile-wallet-api.md.
PAYMENT_WEBHOOK_ALLOW_LEGACY_SECRET=false
WALLET_CURRENCY=PKR

# Public external portal origin used to build mobile asset URLs.
# Do not include a trailing slash.
MOBILE_API_BASE_URL=https://portal.example.com

# Comma-separated allowed browser-client origins. Native Android requests are not governed by CORS.
MOBILE_APP_ORIGIN=https://app.example.com

# Local custom-server port. The production reverse proxy should expose HTTPS/WSS.
PORT=3000
