# DigitalOcean production template for https://portal.megachat.live
# Copy into the Droplet's .env.local, NOT over your local development settings.
# This tracked file intentionally contains no secrets. Fill required blank values
# and replace YOUR_URL_ENCODED_DB_PASSWORD before starting the portal.
# Preserve existing production secrets/passwords; changing them can invalidate sessions.
# For a NEW secret, run: openssl rand -hex 32 (separately for each secret).
# Protect the completed file: chmod 600 .env.local
# Restart the application process after changes; do not commit .env.local.
# Server-only application and database configuration.
# Percent-encode reserved characters in PostgreSQL usernames and passwords.
DATABASE_URL="postgresql://megalive_user:YOUR_URL_ENCODED_DB_PASSWORD@127.0.0.1:5432/megalive"
# REQUIRED: preserve the production AUTH_SECRET, or generate one if never configured.
AUTH_SECRET=
NODE_ENV=production
AUTH_URL=https://portal.megachat.live
# Only behind your own reverse proxy, which must validate/overwrite Host headers.
AUTH_TRUST_HOST=true
MOBILE_SESSION_TTL_SECONDS=2592000

# Portal administrator account. Replace these values before any shared deployment.
ADMIN_EMAIL=admin@megachat.live
# REQUIRED for administrator setup; use a strong unique password.
ADMIN_PASSWORD=

# Signup must not depend on geolocation being available.
GEOLOCATION_REQUIRED=false
TRUST_PROXY_GEO_HEADERS=false
# Exact comma-separated IP addresses of trusted immediate reverse proxies.
# Configure only after confirming your Nginx/proxy topology. Never trust all IPs.
# Proxies must overwrite incoming IP headers; no proxy IP is assumed here.
TRUSTED_PROXY_IPS=

# Active provider: TRTC or LIVEKIT. LiveKit configuration is retained for rollback.
# Google login does not require RTC credentials. Room media DOES require these.
RTC_PROVIDER=TRTC
TRTC_SDK_APP_ID=20044231
TRTC_SECRET_KEY=
TRTC_TOKEN_TTL_SECONDS=300
# Set true ONLY after enabling Advanced Permission Control in Tencent console.
TRTC_ADVANCED_PERMISSION_ENABLED=false
TENCENT_CLOUD_SECRET_ID=
TENCENT_CLOUD_SECRET_KEY=
TRTC_REGION=ap-singapore
# Disabled while RTC_PROVIDER=TRTC. If switching back, set a reachable wss:// URL.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=600

# Google Web/Server client ID whose ID-token audience this server accepts.
# This ID-token login flow needs no Google client secret. Never put secrets in the APK.
GOOGLE_SERVER_CLIENT_ID=1092736404081-3eb8ft742q9p8e91rv3hq5s4br1qhnmp.apps.googleusercontent.com

# A provider-neutral checkout gateway. Configure after selecting a payment provider.
# Leave blank until a real payment provider is configured; do not use a fake gateway.
PAYMENT_CHECKOUT_BASE_URL=
PAYMENT_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=300
# Temporary compatibility only. Keep false in production after the payment provider
# sends the HMAC signature documented in docs/mobile-wallet-api.md.
PAYMENT_WEBHOOK_ALLOW_LEGACY_SECRET=false
WALLET_CURRENCY=PKR
WALLET_TRANSFER_MIN_COINS=100
WALLET_TRANSFER_MAX_COINS=100000
WALLET_WITHDRAWAL_MIN_COINS=10000
WALLET_WITHDRAWAL_MAX_COINS=10000000
WALLET_WITHDRAWAL_COINS_PER_PKR=20

# Independent Events Management module.
# REQUIRED for Events: separate JWT secret and strong admin password.
EVENTS_JWT_SECRET=
EVENTS_SUPER_ADMIN_NAME=Events Super Admin
EVENTS_SUPER_ADMIN_EMAIL=events.admin@megachat.live
EVENTS_SUPER_ADMIN_PASSWORD=
EVENTS_STORAGE_ROOT=storage/events
EVENTS_ACCESS_MINUTES=15
EVENTS_REFRESH_DAYS=30
EVENTS_MAX_UPLOAD_BYTES=104857600
EVENTS_MAX_EXTRACTED_BYTES=262144000
EVENTS_MAX_FILES=5000
# Use "maintenance" to return the branded 503 page for unpublished events.
EVENTS_UNPUBLISHED_MODE=404

# Shared only with trusted backend services that issue activity/event rewards.
INTERNAL_REWARD_SECRET=

# Public external portal origin used to build mobile asset URLs.
# Do not include a trailing slash.
MOBILE_API_BASE_URL=https://portal.megachat.live

# Comma-separated allowed browser-client origins. Native Android requests are not governed by CORS.
MOBILE_APP_ORIGIN=https://portal.megachat.live

# Internal custom-server port. Nginx should expose HTTPS/WSS on public port 443.
PORT=3000

# DigitalOcean Spaces: public catalogue artwork only; credentials stay server-side.
# Enable after adding scoped bucket credentials and applying migrations.
MEDIA_CDN_ENABLED=false
MEDIA_CDN_BASE_URL=https://media.megachat.live
SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
SPACES_BUCKET=megalive-space
SPACES_ACCESS_KEY_ID=
SPACES_SECRET_ACCESS_KEY=
