{
  "name": "mega-live-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "postinstall": "prisma generate",
    "dev": "node server.js --dev --webpack",
    "build": "next build",
    "start": "node server.js",
    "lint": "eslint",
    "test": "vitest run",
    "test:games:db": "node scripts/test-games-db.mjs",
    "test:games:http": "node scripts/test-games-http.mjs",
    "db:seed": "prisma db seed && node prisma/seed-events.mjs",
    "events:seed": "node prisma/seed-events.mjs",
    "wallet:setup": "node scripts/setup-wallet-db.mjs",
    "legacy-ids:import": "node scripts/import-legacy-id-mappings.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.5",
    "file-type": "^22.0.1",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide-react": "^0.468.0",
    "next": "^16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "node-unrar-js": "^2.0.2",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.3",
    "unzipper": "^0.12.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.10",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "vitest": "^4.1.10"
  }
}
